{
  "name": "tab-pilot",
  "productName": "TabPilot",
  "version": "1.0.0",
  "description": "谱领航 TabPilot · 吉他谱自动跟随练习工具（弹到哪跟到哪，谱面高亮 + 放大镜）",
  "main": "src/main.js",
  "author": "WorkBuddy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . TabPilot --platform=win32 --arch=x64 --out=dist --overwrite --app-bundle-id=com.workbuddy.tabpilot --app-version=1.0.0 --icon=icon.ico --ignore=\"^/dist$\" --ignore=\"^/node_modules$\""
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/packager": "^18.0.0"
  }
}
