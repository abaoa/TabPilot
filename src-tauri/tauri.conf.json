{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TabPilot",
  "version": "1.0.0",
  "identifier": "com.workbuddy.tabpilot",
  "mainBinaryName": "TabPilot",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "谱领航 TabPilot · 吉他谱跟随",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "backgroundColor": "#eff2f7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "abaoa",
    "copyright": "Copyright © 2026 abaoa. Licensed under the MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
